JOBOPS_ENVIRONMENT=development
JOBOPS_DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops
JOBOPS_CANDIDATE_PROFILE=data/private/candidate.yaml

# Local-first LLM configuration. Foundry Local does not require an API key.
JOBOPS_LLM_PROVIDER=foundry_local
JOBOPS_LLM_BASE_URL=http://127.0.0.1:39839/v1
JOBOPS_LLM_MODEL=qwen2.5-0.5b
JOBOPS_LLM_API_KEY=
JOBOPS_LLM_TEMPERATURE=0.2
JOBOPS_LLM_MAX_TOKENS=768
JOBOPS_LLM_TIMEOUT_SECONDS=60

# Never commit real provider API keys. Put secrets only in your local .env or secret store.
